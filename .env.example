# ---- Gujarat IVMS backend ----
# Copy to backend/.env (local) or set in Render dashboard (production)

# PostgreSQL (Render provides this; SQLite fallback used when unset)
# DATABASE_URL=postgresql+psycopg2://ivms:ivms_secret@localhost:5432/guj_ivms

# Redis (optional; in-process bus used when unset)
# REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
REQUIRE_AUTH=false
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173

# Demo simulator
SIMULATOR_AUTO_START=true
SIMULATOR_INTERVAL_SECONDS=2.0

# Ingest federation endpoint (Model 3 adapters)
INGEST_API_KEY=

# Sentinel Camera Grid credentials — the grid's sign-in form requires BOTH the
# registered email and the access code. Without both, every live-video and
# snapshot endpoint returns 502.
SENTINEL_EMAIL=you@example.com
SENTINEL_PASSWORD=XXXX-XXXX-XXXX
